# DevinGuard Configuration
# Copy to .env and fill in values

# Devin API
DEVIN_API_KEY=cog_xxx
DEVIN_ORG_ID=org_xxx
DEVIN_API_BASE_URL=https://api.devin.ai

# Sentry
SENTRY_AUTH_TOKEN=sntrys_xxx
SENTRY_ORG_SLUG=your-org
SENTRY_PROJECT_SLUG=payment-service

# PagerDuty
PAGERDUTY_API_KEY=xxx
PAGERDUTY_INTEGRATION_KEY=xxx

# GitHub
GITHUB_TOKEN=ghp_xxx
GITHUB_REPO=your-org/payment-service

# Slack
SLACK_BOT_TOKEN=xoxb-xxx
SLACK_INCIDENT_CHANNEL=C0123456789

# OpenAI (for triage classifier)
OPENAI_API_KEY=sk-proj-xxx

# Redis (for deduplication)
REDIS_URL=redis://localhost:6379/0

# Polling
POLL_INTERVAL_SECONDS=10

# Dedup
DEDUP_WINDOW_SECONDS=300

# Metrics
METRICS_DB_PATH=devinguard_metrics.db
